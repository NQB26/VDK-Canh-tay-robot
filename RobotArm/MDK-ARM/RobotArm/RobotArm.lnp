--cpu Cortex-M3
"robotarm\startup_stm32f103xb.o"
"robotarm\main.o"
"robotarm\stm32f1xx_it.o"
"robotarm\stm32f1xx_hal_msp.o"
"robotarm\stm32f1xx_hal_gpio_ex.o"
