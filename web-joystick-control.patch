+</style>
+</head>
+<body>
+<div class="app">
+  <h1>Điều khiển cánh tay robot 6DOF</h1>
+
+  <div class="status" aria-live="polite">
+    <span class="pill" id="pillWs"><i class="dot"></i><span>Máy chủ: đang kết nối…</span></span>
+    <span class="pill" id="pillSerial"><i class="dot"></i><span>STM32: —</span></span>
