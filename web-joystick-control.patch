+  .chip b { display: block; color: var(--text); font-size: .95rem; font-variant-numeric: tabular-nums; }
+
+  .row { display: grid; grid-template-columns: 112px 1fr 64px; align-items: center; gap: 10px; }
+  .row output { text-align: right; font-variant-numeric: tabular-nums; color: var(--accent); font-weight: 600; }
